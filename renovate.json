{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "mode": "full",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group Rust patch/minor updates into one PR",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "rust dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Rust major updates get individual PRs",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Rust Docker image updates (patch/minor auto-merge)",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["rust"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Rust Docker image major updates need review",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["rust"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Debian runtime image updates",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["debian"],
      "automerge": true
    },
    {
      "description": "Docker Compose service images (postgres, localstack)",
      "matchManagers": ["docker-compose"],
      "automerge": false
    }
  ]
}
